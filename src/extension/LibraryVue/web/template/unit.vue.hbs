<template>
    <!-- 页面头部 -->
    <StarmapPageHeader :unit="codeUnit" />
    <!-- 页面 Tabs -->
    <StarmapPageTabs v-model="activeTab">
        <StarmapPageTab value="readme" icon="ri-book-line">
            <StarmapReadmeWrap  />
        </StarmapPageTab>
        <StarmapPageTab value="files" icon="ri-node-tree"> files </StarmapPageTab>
    </StarmapPageTabs>
</template>

<script>
import metadata from "./metadata.ts"
import StarmapReadmeWrap from "./readme.vue"

// 只同步当前 unit 的 codeUnit / vueMetadata，不要覆盖全局 unitsTree（由根 metadata.ts 维护）
Object.assign(window?.__starmap__ || {}, metadata)

{{{unitVueCode.importCode}}}

export default {
    components: {
         StarmapReadmeWrap,
         {{{unitVueCode.componentsCode}}}
    },
    provide() {
        return { codeUnit: this.codeUnit }
    },
    data() {
        return { codeUnit: metadata.codeUnit, activeTab: "readme" }
    },
    mounted() {
        // code-unit.json 热更新时刷新页头标题等，保留 activeTab 本地状态
        this._onUnitMetaUpdated = (event) => {
            const next = event.detail
            if (!next?.codeUnit || next.codeUnit.id !== this.codeUnit?.id) return
            this.codeUnit = next.codeUnit
            if (next.vueMetadata !== undefined) {
                Object.assign(window?.__starmap__ || {}, { vueMetadata: next.vueMetadata })
            }
        }
        window.addEventListener("starmap:unit-meta-updated", this._onUnitMetaUpdated)
    },
    beforeUnmount() {
        window.removeEventListener("starmap:unit-meta-updated", this._onUnitMetaUpdated)
    },
}

// 单元 metadata（code-unit.json）HMR：更新当前页 codeUnit，不整页刷新
// @ts-ignore
if (import.meta.hot) {
    // @ts-ignore
    import.meta.hot.accept("./metadata.ts", (mod) => {
        if (!mod?.default?.codeUnit) return
        Object.assign(window?.__starmap__ || {}, mod.default)
        window.dispatchEvent(
            new CustomEvent("starmap:unit-meta-updated", { detail: mod.default }),
        )
    })
}
</script>
